<?xml version="1.0" encoding="UTF-8"?>
<project name="HashTableProject" default="default" basedir=".">
    <description>Builds, tests, and runs the project HashTableProject.</description>
    <property file="nbproject/project.properties"/>
    
    <target name="-init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${build.test.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="-init" description="Compile main source files">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" includeantruntime="false" 
               source="${javac.source}" target="${javac.target}" encoding="${source.encoding}"/>
    </target>

    <target name="compile-test" depends="compile" description="Compile test files">
        <javac srcdir="${test.src.dir}" destdir="${build.test.classes.dir}" includeantruntime="false"
               source="${javac.source}" target="${javac.target}" encoding="${source.encoding}">
            <classpath>
                <pathelement path="${build.classes.dir}"/>
            </classpath>
        </javac>
    </target>

    <target name="jar" depends="compile" description="Create executable JAR">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="clean" description="Clean build artifacts">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="test" depends="compile-test" description="Run all unit and oracle tests">
        <java classname="hashtable.test.TestRunner" failonerror="true" fork="true">
            <classpath>
                <pathelement path="${build.classes.dir}"/>
                <pathelement path="${build.test.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <target name="default" depends="jar" description="Default target"/>
</project>
